\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell
\pard\intbl\itap1\sl260{\fs18 \uc0\u1054 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1074  \uc0\u171 \uc0\u1064 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1077  21\uc0\u187  \uc0\u1080  \uc0\u1089  \uc0\u1103 \uc0\u1085 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1103  2026 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1102  \uc0\u1074  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1084  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1080 .{\line}\uc0\u1053 \uc0\u1072  \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1091 \uc0\u1097 \uc0\u1077 \uc0\u1084  \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1077  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1088 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1102  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1080  1-\uc0\u1081  \uc0\u1080  2-\uc0\u1081  \uc0\u1083 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1081 : \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1075 \uc0\u1072 \uc0\u1102  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084  \uc0\u1089  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1055 \uc0\u1050 , \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1080  \uc0\u1080  \uc0\u1055 \uc0\u1054 , \uc0\u1076 \uc0\u1080 \uc0\u1072 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1072 \uc0\u1087 \uc0\u1087 \uc0\u1072 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1080  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1080 , \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1102  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1093  \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 .{\line}\uc0\u1055 \uc0\u1072 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1083 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086  \uc0\u1074  \uc0\u171 \uc0\u1064 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1077  21\uc0\u187  \uc0\u1091 \uc0\u1075 \uc0\u1083 \uc0\u1091 \uc0\u1073 \uc0\u1083 \uc0\u1103 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1074  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1072 \uc0\u1076 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  Linux, Docker, \uc0\u1073 \uc0\u1072 \uc0\u1079 \uc0\u1099  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  (PostgreSQL) \uc0\u1080  CI/CD. \uc0\u1044 \uc0\u1083 \uc0\u1103  \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1099  \uc0\u1080  \uc0\u1085 \uc0\u1072 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1082 \uc0\u1088 \uc0\u1080 \uc0\u1087 \uc0\u1090 \uc0\u1086 \uc0\u1074  (Bash/Python) \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1091 \uc0\u1102  AI-\uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1099 , \uc0\u1087 \uc0\u1088 \uc0\u1080  \uc0\u1101 \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1075 \uc0\u1076 \uc0\u1072  \uc0\u1076 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1073 \uc0\u1080 \uc0\u1088 \uc0\u1072 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1074  \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1082 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1080 \uc0\u1075 \uc0\u1091 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 .{\line}\uc0\u1041 \uc0\u1083 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1103  \uc0\u1102 \uc0\u1088 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1091  \uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1091 \uc0\u1085 \uc0\u1076 \uc0\u1091  \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086  \uc0\u1080  \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1081 \uc0\u1085 \uc0\u1086  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1089 \uc0\u1103  \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 \uc0\u1084 \uc0\u1080 , \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1086  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1072 \uc0\u1087 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1089 \uc0\u1103  \uc0\u1076 \uc0\u1086  \uc0\u1089 \uc0\u1091 \uc0\u1090 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084  \uc0\u1080  \uc0\u1074 \uc0\u1098 \uc0\u1077 \uc0\u1076 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1089 \uc0\u1103  \uc0\u1074  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1091 \uc0\u1102  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102 .{\line}\uc0\u1048 \uc0\u1097 \uc0\u1091  \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1080 \uc0\u1094 \uc0\u1080 \uc0\u1102  \uc0\u1057 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1072 \uc0\u1076 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1072  / \uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1072  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1080  (L2), \uc0\u1075 \uc0\u1076 \uc0\u1077  \uc0\u1089 \uc0\u1084 \uc0\u1086 \uc0\u1075 \uc0\u1091  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080  \uc0\u1072 \uc0\u1076 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1099 .{\line}{\line}{\line}\uc0\u1053 \uc0\u1072 \uc0\u1091 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1080 \uc0\u1089 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}\uc0\u171 \uc0\u1057 \uc0\u1086 \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1091 \uc0\u1076 \uc0\u1092 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1097 \uc0\u1080 \uc0\u1090 \uc0\u1099  \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103  \uc0\u1082 \uc0\u1072 \uc0\u1082  \uc0\u1089 \uc0\u1083 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1081 {\line}\uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1099  \uc0\u1076 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u187  (\uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1103 , \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076  \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1080 );{\line}\uc0\u171 \uc0\u1042 \uc0\u1086 \uc0\u1079 \uc0\u1084 \uc0\u1077 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1091 \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1077 \uc0\u1085 \uc0\u1089 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090  \uc0\u1074  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1077  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 {\line}\uc0\u1089 \uc0\u1086 \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1081  717 \uc0\u1080  729 \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1082 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1072  \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1060 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 \uc0\u187 {\line}(\uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1103 , \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076  \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1080 );{\line}\uc0\u171 \uc0\u1057 \uc0\u1074 \uc0\u1086 \uc0\u1073 \uc0\u1086 \uc0\u1076 \uc0\u1072  \uc0\u1076 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1072 : \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1082 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1076 \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1085 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1099 \uc0\u187  (\uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076  \uc0\u1085 \uc0\u1072 {\line}\uc0\u1082 \uc0\u1088 \uc0\u1091 \uc0\u1078 \uc0\u1082 \uc0\u1077  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072 );{\line}\uc0\u171 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1091 \uc0\u1087 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1076 \uc0\u1091 \uc0\u1088 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1080 {\line}\uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u187  (\uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1103 , \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076  \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1080 );{\line}\uc0\u171 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1091 \uc0\u1089 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102 \uc0\u1097 \uc0\u1077 \uc0\u1075 \uc0\u1086  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1083 \uc0\u1080 \uc0\u1094 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1080 {\line}\uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1082  \uc0\u1089 \uc0\u1091 \uc0\u1073 \uc0\u1089 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1072 \uc0\u1088 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1074  \uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u187  (\uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1103 , \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076  \uc0\u1085 \uc0\u1072 {\line}\uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1080 ){\line}{\line}\uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}- \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1103  \uc0\u1074  7 Moot Court (\uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1072 \uc0\u1093 ) \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093 {\line}\uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1084  \uc0\u1072 \uc0\u1088 \uc0\u1073 \uc0\u1080 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1084 , \uc0\u1042 \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1077 \uc0\u1081  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1096 \uc0\u1085 \uc0\u1077 \uc0\u1081  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1080 ,{\line}\uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1077 \uc0\u1081  \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1078 \uc0\u1073 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1080  \uc0\u1055 \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1077  \uc0\u1056 \uc0\u1060  \uc0\u1080  \uc0\u1076 \uc0\u1088 .;{\line}- \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1099  \uc0\u1089 \uc0\u1090 \uc0\u1091 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1041 \uc0\u1072 \uc0\u1096 \uc0\u1043 \uc0\u1059  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1103  \uc0\u1074  MGIMO Civil Moot{\line}Court ( III \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086  \uc0\u1089 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1080  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  80 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076  \uc0\u1080 \uc0\u1079  \uc0\u1056 \uc0\u1060 );{\line}- \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  (\uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 ) Elementary School of moot{\line}(\uc0\u1089 \uc0\u1086 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1072 \uc0\u1088 \uc0\u1073 \uc0\u1080 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088 ) \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080  \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072  \uc0\u1074  \uc0\u1041 \uc0\u1072 \uc0\u1096 \uc0\u1043 \uc0\u1059 ;{\line}- \uc0\u1074  2019 \uc0\u1075 ., 2020 \uc0\u1075 . \uc0\u1083 \uc0\u1072 \uc0\u1091 \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1090  I \uc0\u1080  II \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1087 \uc0\u1077 \uc0\u1085 \uc0\u1080  \uc0\u1074  \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1085 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1080 {\line}\uc0\u171 \uc0\u1057 \uc0\u1090 \uc0\u1091 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1090  \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u187  \uc0\u1074  \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1070 \uc0\u1088 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 ;{\line}- \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u1074  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  \uc0\u1095 \uc0\u1077 \uc0\u1084  10 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1072 \uc0\u1093  \uc0\u1087 \uc0\u1086  \uc0\u1055 \uc0\u1072 \uc0\u1088 \uc0\u1083 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1084  \uc0\u1076 \uc0\u1077 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1084  (\uc0\u1074  \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1095 \uc0\u1080 \uc0\u1089 \uc0\u1083 \uc0\u1077  I \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086 {\line}\uc0\u1074  \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1077  \uc0\u1087 \uc0\u1086  \uc0\u1055 \uc0\u1072 \uc0\u1088 \uc0\u1083 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1084  \uc0\u1076 \uc0\u1077 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1084  \uc0\u171 I \uc0\u1082 \uc0\u1091 \uc0\u1073 \uc0\u1086 \uc0\u1082  \uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1077 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  2021\uc0\u187 , I \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086  \uc0\u1074 {\line}\uc0\u1055 \uc0\u1072 \uc0\u1088 \uc0\u1083 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1076 \uc0\u1077 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1093  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1082 \uc0\u1072 \uc0\u1093  IV \uc0\u1052 \uc0\u1077 \uc0\u1078 \uc0\u1076 \uc0\u1091 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1103  \uc0\u1057 \uc0\u1072 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081 {\line}\uc0\u1102 \uc0\u1088 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1085 \uc0\u1072 \uc0\u1091 \uc0\u1082 \uc0\u1080 , II \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086  \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1084  \uc0\u1101 \uc0\u1090 \uc0\u1072 \uc0\u1087 \uc0\u1077  III \uc0\u1089 \uc0\u1077 \uc0\u1079 \uc0\u1086 \uc0\u1085 \uc0\u1072  \uc0\u1042 \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1051 \uc0\u1080 \uc0\u1075 \uc0\u1080 {\line}\uc0\u1044 \uc0\u1077 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1076 \uc0\u1088 .){\line}- \uc0\u1072 \uc0\u1073 \uc0\u1089 \uc0\u1086 \uc0\u1083 \uc0\u1102 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  V \uc0\u1042 \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1102 \uc0\u1088 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1084 \uc0\u1087 \uc0\u1080 \uc0\u1072 \uc0\u1076 \uc0\u1099  \uc0\u1087 \uc0\u1086 {\line}\uc0\u1089 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1091  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1081  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1082 \uc0\u1072 \uc0\u1093  V \uc0\u1052 \uc0\u1077 \uc0\u1078 \uc0\u1076 \uc0\u1091 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086 {\line}\uc0\u1102 \uc0\u1088 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1072  \uc0\u171 \uc0\u1055 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1099  \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u187  (\uc0\u1075 . \uc0\u1059 \uc0\u1092 \uc0\u1072 );{\line}- III \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086  \uc0\u1079 \uc0\u1072  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076  \uc0\u1074  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u171 \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1077 , \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1077  \uc0\u1080  \uc0\u1089 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1081 \uc0\u1085 \uc0\u1086 \uc0\u1077 {\line}\uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1086 \uc0\u187  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1082 \uc0\u1072 \uc0\u1093  XVII \uc0\u1052 \uc0\u1077 \uc0\u1078 \uc0\u1076 \uc0\u1091 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1085 \uc0\u1072 \uc0\u1091 \uc0\u1095 \uc0\u1085 \uc0\u1086 -\uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1080 {\line}\uc0\u1089 \uc0\u1090 \uc0\u1091 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 , \uc0\u1072 \uc0\u1089 \uc0\u1087 \uc0\u1080 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1076 \uc0\u1099 \uc0\u1093  \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u171 \uc0\u1055 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1099 {\line}\uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u187  (\uc0\u1075 . \uc0\u1059 \uc0\u1092 \uc0\u1072 );{\line}- \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1091 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1103 \uc0\u1093 , \uc0\u1082 \uc0\u1088 \uc0\u1091 \uc0\u1075 \uc0\u1083 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1072 \uc0\u1093 {\line}{\line}\uc0\u1059 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1099 :{\line}\uc0\u1050 \uc0\u1086 \uc0\u1083 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1099  (\uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1082 \uc0\u1077  \uc0\u1091 \uc0\u1078 \uc0\u1077  \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1086  40 \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1086 \uc0\u1082 ) \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1091 \uc0\u1083 \uc0\u1103 \uc0\u1088 \uc0\u1085 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1091  \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1099  \uc0\u1087 \uc0\u1086  Dungeons & Dragons \uc0\u1074  \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1080  \uc0\u1052 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1072  \uc0\u8212  \uc0\u1083 \uc0\u1102 \uc0\u1073 \uc0\u1083 \uc0\u1102  \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1084 \uc0\u1077 \uc0\u1093 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1080 , \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1089 \uc0\u1102 \uc0\u1078 \uc0\u1077 \uc0\u1090 \uc0\u1099 . \uc0\u1042  \uc0\u1089 \uc0\u1074 \uc0\u1086 \uc0\u1073 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1102  \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1091  \uc0\u1074  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1086 \uc0\u1084  \uc0\u1079 \uc0\u1072 \uc0\u1083 \uc0\u1077  \uc0\u1080  \uc0\u1073 \uc0\u1072 \uc0\u1089 \uc0\u1089 \uc0\u1077 \uc0\u1081 \uc0\u1085 \uc0\u1077 .}\cell\row



