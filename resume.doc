\pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1059 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1082 \par}

\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1050 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 : \uc0\u1055 \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1074  \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u171 \uc0\u1044 \uc0\u1091 \uc0\u1096 \uc0\u1072  \uc0\u1073 \uc0\u1072 \uc0\u1089 \uc0\u1089 \uc0\u1077 \uc0\u1081 \uc0\u1085 \uc0\u1072 \uc0\u187  \uc0\u1087 \uc0\u1086  \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1075 \uc0\u1072 \uc0\u1084  \uc0\u1086 \uc0\u1090 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1089 \uc0\u1080 \uc0\u1074 \uc0\u1072  (\uc0\u1089 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2025) \uc0\u8212  \uc0\u1085 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1076 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1089 \uc0\u1091 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1103  \uc0\u1087 \uc0\u1086  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1084  \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1075 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1072 \uc0\u1084 \uc0\u1099 \uc0\u1081  \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1091 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1100  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1072  \uc0\u1074  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080 , \uc0\u1074 \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1082 \uc0\u1091  \uc0\u1080  \uc0\u1074 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1072 \uc0\u1090 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1092 \uc0\u1077 \uc0\u1088 \uc0\u1091 .{\line}{\line}\uc0\u1056 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1099 :{\line}{\line}1. \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1072  \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072 , \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1072  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082  \uc0\u1080  \uc0\u1072 \uc0\u1083 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072  (Observability Stack){\line}- \uc0\u1047 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1072 : \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1081 \uc0\u1095 \uc0\u1080 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072 , \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1072  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1072 \uc0\u1087 \uc0\u1087 \uc0\u1083 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 , \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1072 \uc0\u1083 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1084 \uc0\u1080 \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1072 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1099 .{\line}- \uc0\u1055 \uc0\u1086 \uc0\u1096 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 :{\line}  - \uc0\u1040 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1072  \uc0\u1080  \uc0\u1086 \uc0\u1088 \uc0\u1082 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 : \uc0\u1057 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1081 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1091  \uc0\u1074  \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1077  Docker Swarm \uc0\u1089  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1096 \uc0\u1085 \uc0\u1080 \uc0\u1093  \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1077 \uc0\u1081  \uc0\u1080  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1074 .{\line}  - \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1072 : \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1091 \uc0\u1083  Prometheus \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1072  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 , Grafana \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , Grafana Loki \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1074  \uc0\u1080  Prometheus Alertmanager \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1091 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1086 \uc0\u1084 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 .{\line}  - Service Discovery: \uc0\u1053 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1083  \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1084 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1091 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  dns_sd_configs \uc0\u1087 \uc0\u1086  \uc0\u1090 \uc0\u1080 \uc0\u1087 \uc0\u1091  A \uc0\u1082  Swarm-\uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1084  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1072  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082  \uc0\u1089  Node Exporter, cAdvisor, Blackbox Exporter \uc0\u1080  \uc0\u1101 \uc0\u1085 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1084 \uc0\u1080 \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1086 \uc0\u1074 .{\line}  - \uc0\u1055 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1072 \uc0\u1083 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072 : \uc0\u1057 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1080 \uc0\u1075 \uc0\u1091 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  alert.rules.yml \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \u