\pard\intbl\itap1\sl260{\fs18
{\cb5\chcfpat5\chcbpat5 Linux,\~Ubuntu}  {\cb5\chcfpat5\chcbpat5 Bash}  {\cb5\chcfpat5\chcbpat5 SSH}  {\cb5\chcfpat5\chcbpat5 \uc0\u1057 \uc0\u1077 \uc0\u1090 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077 \~\uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080 ,\~TCP/IP,\~DNS,\~NTP}  {\cb5\chcfpat5\chcbpat5 Systemd,\~Cron}  {\cb5\chcfpat5\chcbpat5 \uc0\u1051 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 ,\~\uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \~\uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1052 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1089 \~\uc0\u1092 \uc0\u1072 \uc0\u1081 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1084 \uc0\u1080 \~\uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1074 \~\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081 \~\uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1082 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 Vim,\~Nano}  {\cb5\chcfpat5\chcbpat5 Git}  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1085 \uc0\u1075 \uc0\u1083 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081 \~\uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \~\uc0\u1040 2}  {\cb5\chcfpat5\chcbpat5 Gitlab}  {\cb5\chcfpat5\chcbpat5 Prometheus}  {\cb5\chcfpat5\chcbpat5 Grafana}  {\cb5\chcfpat5\chcbpat5 Docker}  {\cb5\chcfpat5\chcbpat5 Docker-compose}  {\cb5\chcfpat5\chcbpat5 GitLab-CI/CD}  {\cb5\chcfpat5\chcbpat5 Python}  {\cb5\chcfpat5\chcbpat5 Nginx}  {\cb5\chcfpat5\chcbpat5 SQL}  {\cb5\chcfpat5\chcbpat5 PostgreSQL}  {\cb5\chcfpat5\chcbpat5 DHCP}  {\cb5\chcfpat5\chcbpat5 \uc0\u1058 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1103 \~\uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 Linux}}\cell\row

